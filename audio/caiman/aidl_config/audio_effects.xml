<?xml version="1.0" encoding="UTF-8"?>
<audio_effects_conf version="2.0" xmlns="http://schemas.android.com/audio/audio_effects_conf/v2_0">

    <libraries>
        <library name="pre_processing" path="libaudiopreprocessing.so"/>
        <library name="bundle" path="libbundleaidl.so"/>
        <library name="reverb" path="libreverbaidl.so"/>
        <library name="visualizer" path="libvisualizeraidl.so"/>
        <library name="downmix" path="libdownmixaidl.so"/>
        <library name="loudness_enhancer" path="libloudnessenhanceraidl.so"/>
        <library name="dynamics_processing" path="libdynamicsprocessingaidl.so"/>
        <library name="spatializer" path="libswspatializer.so"/>
        <library name="haptic_generator" path="libhapticgeneratoraidl.so"/>
        <library name="proxy" path="libeffectproxy.so"/>
    </libraries>

    <effects>
        <effect name="agc" library="pre_processing" uuid="aa8130e0-66fc-11e0-bad0-0002a5d5c51b"/>
        <effect name="aec" library="pre_processing" uuid="bb392ec0-8d4d-11e0-a896-0002a5d5c51b"/>
        <effect name="ns" library="pre_processing" uuid="c06c8400-8e06-11e0-9cb6-0002a5d5c51b"/>
        <effect name="bassboost" library="bundle" uuid="8631f300-72e2-11df-b57e-0002a5d5c51b"/>
        <effect name="virtualizer" library="bundle" uuid="1d4033c0-8557-11df-9f2d-0002a5d5c51b"/>
        <effect name="equalizer" library="bundle" uuid="ce772f20-847d-11df-bb17-0002a5d5c51b"/>
        <effect name="volume" library="bundle" uuid="119341a0-8469-11df-81f9-0002a5d5c51b"/>
        <effect name="spatializer" library="spatializer" uuid="ccf2ae20-ee71-11e3-bc5b-0002a5d5c51b"/>
        <effect name="reverb_env_aux" library="reverb" uuid="4a387fc0-8ab3-11df-8bad-0002a5d5c51b"/>
        <effect name="reverb_env_ins" library="reverb" uuid="c7a511a0-a3bb-11df-860e-0002a5d5c51b"/>
        <effect name="reverb_pre_aux" library="reverb" uuid="f29a1400-a3bb-11df-8ddc-0002a5d5c51b"/>
        <effect name="reverb_pre_ins" library="reverb" uuid="172cdf00-a3bc-11df-a72f-0002a5d5c51b"/>
        <effect name="visualizer" library="visualizer" uuid="d069d9e0-8329-11df-9168-0002a5d5c51b"/>
        <effect name="downmix" library="downmix" uuid="93f04452-e4fe-41cc-91f9-e475b6d1d69f"/>
        <effect name="loudness_enhancer" library="loudness_enhancer" uuid="fa415329-2034-4bea-b5dc-5b381c8d1e2c"/>
        <effect name="dynamics_processing" library="dynamics_processing" uuid="e0e6539b-1781-7261-676f-6d7573696340"/>
        <effect name="haptic_generator" library="haptic_generator" uuid="97c4acd1-8b82-4f2f-832e-c2fe5d7a9931"/>
    </effects>

    <preprocess>
        <stream type="mic">
            <apply effect="ns"/>
        </stream>
        <stream type="voice_call">
            <apply effect="aec"/>
            <apply effect="ns"/>
        </stream>
        <stream type="camcorder">
            <apply effect="agc"/>
        </stream>
        <stream type="voice_recognition">
            <apply effect="ns"/>
            <apply effect="agc"/>
        </stream>
        <stream type="voice_communication">
            <apply effect="aec"/>
            <apply effect="ns"/>
            <apply effect="agc"/>
        </stream>
    </preprocess>
    
    <deviceEffects>
        <devicePort type="AUDIO_DEVICE_OUT_SPEAKER">
            <apply effect="volume"/>
            <apply effect="visualizer"/>
            <apply effect="spatializer"/>
            <apply effect="haptic_generator"/>
        </devicePort>

        <devicePort type="AUDIO_DEVICE_OUT_WIRED_HEADSET">
            <apply effect="volume"/>
            <apply effect="visualizer"/>
            <apply effect="spatializer"/>
            <apply effect="haptic_generator"/>
        </devicePort>

        <devicePort type="AUDIO_DEVICE_OUT_WIRED_HEADPHONE">
            <apply effect="volume"/>
            <apply effect="visualizer"/>
            <apply effect="spatializer"/>
            <apply effect="haptic_generator"/>
        </devicePort>

        <devicePort type="AUDIO_DEVICE_OUT_BLUETOOTH_A2DP">
            <apply effect="volume"/>
            <apply effect="visualizer"/>
            <apply effect="spatializer"/>
            <apply effect="haptic_generator"/>
        </devicePort>

        <devicePort type="AUDIO_DEVICE_OUT_BLUETOOTH_SCO">
            <apply effect="volume"/>
            <apply effect="visualizer"/>
            <apply effect="spatializer"/>
            <apply effect="haptic_generator"/>
        </devicePort>

        <devicePort type="AUDIO_DEVICE_OUT_BLE_HEADSET">
            <apply effect="volume"/>
            <apply effect="visualizer"/>
            <apply effect="spatializer"/>
            <apply effect="haptic_generator"/>
        </devicePort>

        <devicePort type="AUDIO_DEVICE_OUT_USB_HEADSET">
            <apply effect="volume"/>
            <apply effect="visualizer"/>
            <apply effect="spatializer"/>
            <apply effect="haptic_generator"/>
        </devicePort>
    </deviceEffects>

</audio_effects_conf>
